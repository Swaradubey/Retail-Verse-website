# Server Configuration
PORT=5000
NODE_ENV=production

# Database Configuration
MONGO_URI=your-mongodb-atlas-uri

# Authentication
JWT_SECRET=your-jwt-secret
JWT_EXPIRE=30d
SESSION_SECRET=your-session-secret

# CORS Configuration
CLIENT_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Shiprocket Configuration (Optional)
SHIPROCKET_BASE_URL=https://apiv2.shiprocket.in
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_LOCATION=Home
SHIPROCKET_DEFAULT_WEIGHT_KG=0.5
SHIPROCKET_DEFAULT_DIMENSION_CM=10

# Razorpay Configuration (Optional)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Zendesk Configuration (Optional)
ZENDESK_SUBDOMAIN=
ZENDESK_EMAIL=
ZENDESK_API_TOKEN=
ZENDESK_BASE_URL=

# Google OAuth Configuration (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/auth/google/callback

# SMTP Email Configuration (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
EMAIL_FROM=
SMTP_FROM_NAME=RetailVerse

# OpenAI Configuration (Optional)
OPENAI_API_KEY=

# Gemini Configuration (Optional)
GEMINI_API_KEY=
GEMINI_TRANSCRIPTION_MODEL=gemini-3.1-flash-lite
GEMINI_ORDER_MODEL=gemini-3.1-flash-lite
MAX_TRANSCRIPT_LENGTH=20000

# Shared Voice Order Settings
MAX_AUDIO_FILE_SIZE_MB=25
VOICE_ORDER_RETENTION_DAYS=90

# Marketplace Integration Configuration
APP_URL=http://localhost:5000
MARKETPLACE_ENCRYPTION_KEY=
MARKETPLACE_WORKER_ENABLED=true
MARKETPLACE_WORKER_INTERVAL_MS=10000
MARKETPLACE_JOB_MAX_ATTEMPTS=5

# Amazon SP-API Integration (Optional)
AMAZON_LWA_CLIENT_ID=
AMAZON_LWA_CLIENT_SECRET=
AMAZON_SP_API_APP_ID=
AMAZON_REDIRECT_URI=http://localhost:5000/api/marketplaces/amazon/callback
AMAZON_SP_API_REGION=FE

# Shopify Integration (Optional)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_REDIRECT_URI=http://localhost:5000/api/marketplaces/shopify/callback
SHOPIFY_SCOPES=read_products,write_products,read_inventory,write_inventory,read_orders,read_locations
SHOPIFY_API_VERSION=2024-07
SHOPIFY_LOCATION_ID=
SHOPIFY_INVENTORY_SYNC_ENABLED=true

# Flipkart Integration (Optional)
FLIPKART_CLIENT_ID=
FLIPKART_CLIENT_SECRET=
