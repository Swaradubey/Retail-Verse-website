# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# MONGO_URI=mongodb://localhost:27017/ecoshop
MONGO_URI=mongodb://localhost:27017/ecoshop

# Authentication
JWT_SECRET=change-this-to-a-random-secret
JWT_EXPIRE=30d

# SUPER_ADMIN_EMAIL=you@example.com
# SUPER_ADMIN_PASSWORD=your_secure_password

# CORS Configuration
CLIENT_ORIGIN=http://localhost:5173

# FRONTEND_URL — ⚠️ CRITICAL for password-reset email links
# In dev:  http://localhost:5173
# In prod: https://your-production-domain.com
FRONTEND_URL=http://localhost:5173

# Shiprocket (server-only — live tracking + auto shipment at checkout + optional admin "Shipped" step)
# Use API user credentials from Shiprocket: Settings → API. Keys must start at column 0 (no leading spaces).
SHIPROCKET_BASE_URL=https://apiv2.shiprocket.in
SHIPROCKET_EMAIL=your-shiprocket-email@example.com
SHIPROCKET_PASSWORD=your-shiprocket-password
# Optional — adhoc pickup nickname in code is fixed to exactly "Home" (must exist in Shiprocket pickup locations).
SHIPROCKET_PICKUP_LOCATION=Home
SHIPROCKET_DEFAULT_WEIGHT_KG=0.5
SHIPROCKET_DEFAULT_DIMENSION_CM=10


# Razorpay Credentials (Required for payments)
# Get test keys from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx


# Zendesk Configuration
ZENDESK_SUBDOMAIN=your-subdomain
ZENDESK_EMAIL=your-zendesk-email@example.com
ZENDESK_API_TOKEN=your-zendesk-api-token
ZENDESK_BASE_URL=https://your_subdomain.zendesk.com/api/v2

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5000/auth/google/callback
SESSION_SECRET=change-this-session-secret
FRONTEND_URL=http://localhost:5173


#
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=your-email@gmail.com
EMAIL_FROM=your-email@gmail.com
SMTP_FROM_NAME=RetailVerse



# ── OpenAI (optional — use if AI_TRANSCRIPTION_PROVIDER=openai) ────────────────
# OpenAI API key (server-only — never commit real keys)
OPENAI_API_KEY=


# ── Gemini (optional — use if AI_TRANSCRIPTION_PROVIDER=gemini) ────────────────
# Get a free API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_TRANSCRIPTION_MODEL=
GEMINI_ORDER_MODEL=

# Max transcription text length sent to the order extraction model (characters)
MAX_TRANSCRIPT_LENGTH=20000

# ── Shared Voice Order Settings ───────────────────────────────────────────────
# Max audio file size in MB (default: 25)
MAX_AUDIO_FILE_SIZE_MB=25

# Days to retain voice-order audio files (0 = keep forever)
VOICE_ORDER_RETENTION_DAYS=90

# ── Marketplace Integration Configuration ───────────────────────────────────────
APP_URL=http://localhost:5000

MARKETPLACE_ENCRYPTION_KEY=
MARKETPLACE_WORKER_ENABLED=true
MARKETPLACE_WORKER_INTERVAL_MS=10000
MARKETPLACE_JOB_MAX_ATTEMPTS=5

AMAZON_LWA_CLIENT_ID=your-amazon-lwa-client-id
AMAZON_LWA_CLIENT_SECRET=your-amazon-lwa-client-secret
AMAZON_SP_API_APP_ID=
AMAZON_REDIRECT_URI=http://localhost:5000/api/marketplaces/amazon/callback
AMAZON_SP_API_REGION=FE

SHOPIFY_API_KEY=your-shopify-api-key
SHOPIFY_API_SECRET=your-shopify-api-secret
SHOPIFY_REDIRECT_URI=http://localhost:5000/api/marketplaces/shopify/callback
SHOPIFY_SCOPES=read_products,write_products,read_inventory,write_inventory,read_orders,read_locations
SHOPIFY_API_VERSION=2024-07
SHOPIFY_LOCATION_ID=
SHOPIFY_INVENTORY_SYNC_ENABLED=true

FLIPKART_CLIENT_ID=
FLIPKART_CLIENT_SECRET=



