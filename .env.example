# ═══════════════════════════════════════════════════════════════════════════
# FRONTEND Environment Variables
# ═══════════════════════════════════════════════════════════════════════════
# The URL of your backend on Render (or other host).
# In dev, the Vite proxy handles /api/* automatically.
# In production (Vercel), you MUST set the production backend URL:
#   VITE_API_URL=https://your-backend-domain.com
#   VITE_API_BASE_URL=https://your-backend-domain.com/api
VITE_API_URL=http://localhost:5000
VITE_API_BASE_URL=http://localhost:5000/api

# ─── PRODUCTION (Vercel) — add these in Vercel → Settings → Environment Variables ───
# VITE_API_URL=https://omni-commerce-website.onrender.com
# VITE_API_BASE_URL=https://omni-commerce-website.onrender.com/api

# Razorpay
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx

# ═══════════════════════════════════════════════════════════════════════════
# BACKEND — AI Voice Order (place only in the backend .env, never publicly)
# ═══════════════════════════════════════════════════════════════════════════
# Either OpenAI or Gemini must be configured. Both are optional — pick one.
#
# OpenAI:
#   OPENAI_API_KEY=<your key>
#   AI_TRANSCRIPTION_PROVIDER=openai
#   AI_ORDER_EXTRACTION_PROVIDER=openai
#
# Gemini (recommended — free tier available):
#   GEMINI_API_KEY=<your key from https://aistudio.google.com/apikey>
#   AI_TRANSCRIPTION_PROVIDER=gemini
#   AI_ORDER_EXTRACTION_PROVIDER=gemini
#
# Model used for audio transcription (default: whisper-1 for OpenAI, gemini-3.1-flash-lite for Gemini)
# AI_TRANSCRIPTION_MODEL=
# Model used for structured order extraction from text (default: gpt-4o for OpenAI, gemini-3.1-flash-lite for Gemini)
# AI_ORDER_MODEL=
# Maximum audio file size in megabytes (default: 25)
MAX_AUDIO_FILE_SIZE_MB=25
# Max transcription text length for extraction (default: 20000)
MAX_TRANSCRIPT_LENGTH=20000
