# VITE Frontend Environment Variables

# The URL of your backend API (no trailing slash)
VITE_API_URL=http://localhost:5000

# The base path of your backend API endpoints
VITE_API_BASE_URL=http://localhost:5000/api

# Razorpay Key ID for payments (get test key from Razorpay dashboard)
VITE_RAZORPAY_KEY_ID=

# Maximum audio file size in megabytes for voice orders (default: 25)
MAX_AUDIO_FILE_SIZE_MB=25

# Max transcription text length for extraction (default: 20000)
MAX_TRANSCRIPT_LENGTH=20000
